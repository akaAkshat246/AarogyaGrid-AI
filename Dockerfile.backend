# ==============================================================================
# AarogyaGrid Backend - Node.js Express Container
# ==============================================================================
FROM node:22-alpine

WORKDIR /app

# Copy package files and install dependencies
COPY Backend/package*.json ./
RUN npm ci --omit=dev

# Copy backend source
COPY Backend/ .

EXPOSE 5000

ENV NODE_ENV=production \
    PORT=5000 \
    HOST=0.0.0.0

CMD ["node", "server.js"]
