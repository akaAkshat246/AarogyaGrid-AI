# ==============================================================================
# AarogyaGrid AI - Environment Configuration Example
# ==============================================================================

# Application Settings
APP_ENV=development
STORAGE_BACKEND=mock             # 'mock' for local development, 'firestore' for live GCP
PORT=8000                        # Python AI Service Port
BACKEND_PORT=5000                # Node.js Express API Port
HOST=127.0.0.1

# AI Service Settings
AI_URL=http://127.0.0.1:8000
AI_PREDICT_PATH=/predict
AI_TIMEOUT_MS=15000
AI_API_KEY=

# Google Cloud & Firebase (Optional in mock mode)
GCP_PROJECT_ID=aarogyagrid-dev
GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json
BIGQUERY_ENABLED=false
BIGQUERY_DATASET=aarogyagrid_analytics

# Gemini API (For Grounded Operations Assistant)
GEMINI_API_KEY=

# CORS & Auth Settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEV_SKIP_AUTH=true               # Set to 'false' in production with real Firebase ID tokens
